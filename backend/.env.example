# Copy to .env and fill in real values. Never commit .env.

# Required when COACHING_PROVIDER=gemini (default)
GEMINI_API_KEY=

# Optional model override (default: gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Optional override (default: gemini)
# COACHING_PROVIDER=gemini

# Used when COACHING_PROVIDER=bedrock
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# PostgreSQL (session / attempt logging)
# Create DB first, e.g. CREATE DATABASE gestures;
# Or use an existing local DB name (some machines already have gestures_db).
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestures
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# Ollama (OpenAI-compatible) — polish backup + conversational FALLBACK
# Example LAN Ollama: http://172.16.200.30:11434/v1/
OLLAMA_BASE_URL=http://172.16.200.30:11434/v1/
OLLAMA_MODEL=llama3.1:latest
# OLLAMA_TIMEOUT_SECONDS=45

# ElevenLabs — PRIMARY polish + conversational reply + TTS (AAC / ASL / ISL)
# Keep the API key backend-only. Never put it in NEXT_PUBLIC_* or frontend code.
ELEVENLABS_API_KEY=
# Low-latency TTS model (override if your account uses a different id)
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# Required for TTS. Copy a voice id from the ElevenLabs Voices UI / GET /v1/voices.
ELEVENLABS_VOICE_ID=
# Optional: reuse a pre-created text-only ConvAI agent for replies. If empty,
# one is created lazily on first /ml/reply. Polish uses a separate agent.
# ELEVENLABS_AGENT_ID=
# ELEVENLABS_TIMEOUT_SECONDS=45
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
